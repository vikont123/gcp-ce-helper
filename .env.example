# Copy to .env.local and fill in real values. .env.local is gitignored.
# See README.md -> "Environment variables" for what each one does.

# --- Google Sheet (system of record) ---
SPREADSHEET_ID=
SHEET_TAB=DBTask
CE_FILTER_NAME=
# Optional: in-memory Sheet cache TTL in ms
SHEET_CACHE_TTL_MS=

# --- BigQuery (AI-artifact caches) ---
# Both optional; default to mytestingenv-355509 / gcp_crm_data
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=

# --- Gemini (Developer API) ---
GOOGLE_API_KEY=
MODEL_PRO=
MODEL_FLASH=

# --- NextAuth (Google OAuth) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Local dev: http://localhost:3000 — in prod must equal the live Cloud Run URL
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Local dev credentials for Sheets/BigQuery ---
# Path to a service-account key JSON. LOCAL DEV ONLY.
# OMIT this in production (Cloud Run uses ADC = the runtime SA).
# Preferred for local dev instead of a key file: `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=
